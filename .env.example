# ============================================================
# OmniAI Cloud — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored; never commit it.
# ============================================================

# ---- Runtime profile --------------------------------------
# full : all models run locally (PyTorch + PaddleOCR). Matches the paper.
#        Requires Python 3.11 and ~6 GB of model weights.
# lite : models are served by the Mistral API. Runs on any Python 3.11+,
#        small enough to deploy. Needs OMNIAI_MISTRAL_API_KEY.
OMNIAI_PROFILE=lite

# ---- Mistral API ------------------------------------------
# Required for the `lite` profile and for document summarisation in `full`.
# Get one at https://console.mistral.ai/api-keys
OMNIAI_MISTRAL_API_KEY=

# Model IDs. `-latest` aliases track Mistral's current production models.
# NOTE: mistral-large is not available on standard keys. Check what yours can
# reach with:  curl -H "Authorization: Bearer $KEY" https://api.mistral.ai/v1/models
OMNIAI_MISTRAL_TEXT_MODEL=mistral-medium-latest
OMNIAI_MISTRAL_VISION_MODEL=mistral-medium-latest
OMNIAI_MISTRAL_OCR_MODEL=mistral-ocr-latest

# Accuracy: a second model gives an independent opinion on image
# classification, and a reasoning model settles disagreements. Costs one or two
# extra calls per image. Set to false for the cheapest possible path.
OMNIAI_ENSEMBLE=true
OMNIAI_MISTRAL_REASONING_MODEL=magistral-medium-latest
OMNIAI_MISTRAL_FAST_MODEL=mistral-small-latest

# ---- Server -----------------------------------------------
OMNIAI_HOST=127.0.0.1
OMNIAI_PORT=8000
OMNIAI_DEBUG=false
# Comma-separated. Leave blank to allow same-origin only.
OMNIAI_CORS_ORIGINS=

# ---- Limits (bytes / counts) ------------------------------
OMNIAI_MAX_UPLOAD_BYTES=26214400
OMNIAI_MAX_PDF_PAGES=200
OMNIAI_MAX_IMAGE_PIXELS=50000000
OMNIAI_MAX_TEXT_CHARS=20000
OMNIAI_RATE_LIMIT_PER_MINUTE=20

# ---- Local (full) profile only ----------------------------
# Directory holding locally downloaded HF weights.
OMNIAI_MODEL_DIR=backend/models/downloaded_models
# Poppler `bin` directory, for rasterising scanned PDFs.
# Leave blank to auto-detect from PATH (correct on Linux/macOS/Docker).
OMNIAI_POPPLER_PATH=
# cpu | cuda | auto
OMNIAI_TORCH_DEVICE=auto
