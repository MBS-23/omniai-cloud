# ============================================================
# OmniAI Cloud - environment configuration
# Copy to `.env` for local use. Never commit real values.
# ============================================================

# ---- Runtime profile --------------------------------------
# paper   : the models published in the paper (ResNet50, YOLOv8n/x,
#           PaddleOCR, BLIP, NLLB-200, spaCy, RoBERTa, T5), from Hugging
#           Face, running locally. No API key, no rate limit. Runs in the
#           Docker image and on the Hugging Face Space. ("full" also works.)
# offline : also local, with substitutes that install on Python 3.14.
# lite    : models served by a hosted API (Gemini or Mistral). The only
#           profile that fits a serverless host such as Vercel.
# Leave unset to use the most faithful profile whose packages are installed.
OMNIAI_PROFILE=offline

# ---- Local profiles (paper, offline) ----------------------
# Load models at startup rather than on first use: all | core | none.
# "core" pre-loads OCR and translation, as the paper does.
OMNIAI_PRELOAD=core
# PaddleOCR language packs to try, in order (paper profile).
OMNIAI_OCR_LANGS=en,te,hi
# t5 (local, the default) or mistral (needs OMNIAI_MISTRAL_API_KEY).
OMNIAI_SUMMARIZER=t5
# int8 (default) quantises BLIP, NLLB and T5 on CPU; none keeps full precision.
OMNIAI_QUANTIZE=int8
# Memory the local models may use, in MB. 0 means no limit. With a limit, the
# least recently used model is unloaded when the next one would not fit.
OMNIAI_MODEL_BUDGET_MB=0
# Analyses that may run at once; further requests are asked to retry.
OMNIAI_MAX_CONCURRENT=2
# Pages of a scanned PDF read with OCR.
OMNIAI_MAX_OCR_PAGES=15

# ---- Gemini API (the hosted provider for the lite profile) --
# Only needed for the lite profile.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY and GOOGLE_API_KEY are accepted as alternative names.
OMNIAI_GEMINI_API_KEY=

# ---- Mistral API (optional alternative to Gemini) ----------
# Used by the lite profile only when no Gemini key is set, or when
# OMNIAI_HOSTED_PROVIDER=mistral. Leave blank if you are using Gemini.
# Get one at https://console.mistral.ai/api-keys
OMNIAI_MISTRAL_API_KEY=

# Model IDs. `-latest` aliases track Mistral's current production models.
# NOTE: mistral-large is not available on standard keys. Check what yours can
# reach with:  curl -H "Authorization: Bearer $KEY" https://api.mistral.ai/v1/models
OMNIAI_MISTRAL_TEXT_MODEL=mistral-medium-latest
OMNIAI_MISTRAL_VISION_MODEL=mistral-medium-latest
OMNIAI_MISTRAL_OCR_MODEL=mistral-ocr-latest

# Accuracy: a second model gives an independent opinion on image
# classification, and a reasoning model settles disagreements. Costs one or two
# extra calls per image. Set to false for the cheapest possible path.
OMNIAI_ENSEMBLE=true
OMNIAI_MISTRAL_REASONING_MODEL=magistral-medium-latest
OMNIAI_MISTRAL_FAST_MODEL=mistral-small-latest

# ---- Server -----------------------------------------------
OMNIAI_HOST=127.0.0.1
OMNIAI_PORT=8000
OMNIAI_DEBUG=false
# Comma-separated. Leave blank to allow same-origin only.
OMNIAI_CORS_ORIGINS=
# Reverse proxies in front of the app (0 when it is reached directly).
OMNIAI_TRUSTED_PROXIES=0

# ---- Limits (bytes / counts) ------------------------------
OMNIAI_MAX_UPLOAD_BYTES=26214400
OMNIAI_MAX_PDF_PAGES=200
OMNIAI_MAX_IMAGE_PIXELS=50000000
OMNIAI_MAX_TEXT_CHARS=20000
OMNIAI_RATE_LIMIT_PER_MINUTE=20

# ---- Local profiles: paths and device -----------------------
# Directory holding locally downloaded HF weights.
OMNIAI_MODEL_DIR=backend/models/downloaded_models
# Poppler `bin` directory, for rasterising scanned PDFs.
# Leave blank to auto-detect from PATH (correct on Linux/macOS/Docker).
OMNIAI_POPPLER_PATH=
# cpu | cuda | auto
OMNIAI_TORCH_DEVICE=auto
